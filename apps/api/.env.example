# Copy to .env and adjust. .env is gitignored and must never be committed.

# Local development database, started with `docker compose up -d` from the repo root.
# Port 5433 on the host so it cannot collide with a locally installed Postgres.
DATABASE_URL="postgresql://cubecoach:local_development_only@localhost:5433/cubecoach?schema=public"

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Integration tests run against a separate database so they never destroy dev data.
# It is created and migrated automatically on the first test run.
TEST_DATABASE_URL="postgresql://cubecoach:local_development_only@localhost:5433/cubecoach_test?schema=public"

# Where the web client runs. CORS names this origin explicitly, because the wildcard
# is not allowed when credentials (our session cookie) are involved.
WEB_ORIGIN="http://localhost:5173"

# Google sign-in. Optional: leave these unset and the option simply does not appear.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# with this exact redirect URI registered.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# The model that rewrites solver step explanations (ADR-0022). Optional: leave the key
# unset and every step is explained by the template. Create the key at
# https://aistudio.google.com in a Google Cloud project with NO billing linked, so the
# free tier is a hard limit and nothing can be charged.
# GEMINI_API_KEY=
# EXPLANATION_MODEL=gemini-3.5-flash-lite
# Model calls per day. Keep it just under the model's free requests per day.
# EXPLANATION_DAILY_CALL_CAP=450
