// Database schema. See docs/database.md for the reasoning behind these choices.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A registered user.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Stored already lowercased, and compared that way, so "A@b.com" and "a@b.com"
  /// cannot both register. Postgres could enforce this with a citext column, but that
  /// needs an extension; normalising in one place in the application is simpler and
  /// has no deployment cost.
  email String @unique

  passwordHash String @map("password_hash")
  displayName  String @map("display_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  authSessions     AuthSession[]
  practiceSessions PracticeSession[]
  solves           Solve[]

  @@map("users")
}

/// A login session. Named `auth_sessions`, never `sessions`, because "session" also
/// means a practice session in this domain and confusing the two would be easy.
model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The session token is stored hashed, never in plain text. A leaked database dump
  /// then does not hand the attacker working sessions.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// A named practice session that solves are grouped into. Statistics are calculated
/// per practice session, which is how cubers actually work.
model PracticeSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name       String
  puzzleType PuzzleType @default(THREE_BY_THREE) @map("puzzle_type")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  solves Solve[]

  @@index([userId])
  @@map("practice_sessions")
}

/// A single solve.
model Solve {
  /// Generated by the client before the request is sent, so a retry after a dropped
  /// connection re-sends the same id and cannot create a duplicate. Losing or
  /// duplicating a solve is the worst failure this product has.
  id String @id @db.Uuid

  userId            String @map("user_id") @db.Uuid
  practiceSessionId String @map("practice_session_id") @db.Uuid

  scramble   String
  puzzleType PuzzleType @default(THREE_BY_THREE) @map("puzzle_type")

  /// The raw time in whole milliseconds. Integers, not floats, so comparisons and
  /// display are exact.
  ///
  /// A +2 penalty is NOT added in here. The penalty is stored separately and applied
  /// when reading, because penalties get corrected after the fact and baking one into
  /// the number makes toggling it a subtraction that can go wrong.
  durationMs Int @map("duration_ms")

  penalty Penalty @default(NONE)
  comment String?

  solvedAt  DateTime  @map("solved_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Soft delete: mis-taps on a timer are common and undo should be possible.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  /// History and statistics both read newest-first within a scope, and pagination is
  /// keyed on (solvedAt, id). These indexes are what keep that cheap.
  @@index([userId, solvedAt(sort: Desc)])
  @@index([practiceSessionId, solvedAt(sort: Desc)])
  @@map("solves")
}

enum Penalty {
  /// A clean solve.
  NONE
  /// Two seconds added, per competition rules.
  PLUS_TWO
  /// Did not finish. Counts as worse than any time, and is not a number.
  DNF

  @@map("penalty")
}

enum PuzzleType {
  THREE_BY_THREE

  @@map("puzzle_type")
}
